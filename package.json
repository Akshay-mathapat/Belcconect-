{
  "name": "belconnect-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node dev.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:e2e": "cd frontend && npx playwright test",
    "test:e2e:ui": "cd frontend && npx playwright test --ui",
    "test:e2e:report": "cd frontend && npx playwright show-report",
    "migrate": "node scripts/run-migrations.js",
    "migrate:status": "node scripts/run-migrations.js --status",
    "migrate:test": "node scripts/run-migrations.js --target test",
    "check:auth-await": "npm --prefix frontend run check:auth-await",
    "preflight": "node scripts/preflight.js",
    "smoke": "node scripts/smoke-test.js",
    "compare-fingerprints": "node scripts/compare-fingerprints.js"
  }
}
