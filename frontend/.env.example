# ==============================================================================
# BELCONNECT — FRONTEND (VERCEL DEPLOYMENT) ENVIRONMENT VARIABLE TEMPLATE
# ==============================================================================
# IMPORTANT:
# 1. Configure these in Vercel Dashboard -> Project Settings -> Environment Variables.
# 2. Values in this file must NOT be wrapped in quotes (e.g. write KEY=value, NOT KEY="value").
# 3. All secrets (JWT_SECRET, SIGNALING_INTERNAL_SECRET, INTERNAL_API_SECRET) MUST be at least 32 characters long.
# ==============================================================================

# Node runtime environment mode (development | test | production). Do NOT wrap in quotes.
NODE_ENV=production

# Public web application canonical URL for frontend clients (no trailing slash). Do NOT wrap in quotes.
NEXT_PUBLIC_APP_URL=https://belconnect.vercel.app

# Canonical application URL used by server-side OAuth callbacks (no trailing slash). Do NOT wrap in quotes.
APP_URL=https://belconnect.vercel.app

# Public WebSocket / Socket.IO signaling server URL on Render (no trailing slash; cannot be Vercel). Do NOT wrap in quotes.
NEXT_PUBLIC_SIGNALING_URL=https://belconnect-backend.onrender.com

# Internal server-side signaling URL alias used by Next.js API route proxies (no trailing slash). Do NOT wrap in quotes.
SIGNALING_SERVER_URL=https://belconnect-backend.onrender.com

# Shared secret for internal communication between Next.js frontend and Render Socket.IO server (min 32 characters). Do NOT wrap in quotes.
SIGNALING_INTERNAL_SECRET=placeholder_signaling_secret_must_be_at_least_32_chars_long

# Shared secret for authenticating internal API endpoints such as native location push (min 32 characters). Do NOT wrap in quotes.
INTERNAL_API_SECRET=placeholder_internal_api_secret_must_be_at_least_32_characters

# Secret key for signing and verifying user JWT authentication tokens (min 32 characters). Do NOT wrap in quotes.
JWT_SECRET=placeholder_jwt_secret_must_be_at_least_32_characters_long

# Primary PostgreSQL database connection string (Neon / Render / Supabase). Do NOT wrap in quotes.
DATABASE_URL=postgresql://postgres:placeholder_password@placeholder_host:5432/placeholder_db?sslmode=require

# Database URL fallback alias recognized by connection logic. Do NOT wrap in quotes.
DATABASE_URI=postgresql://postgres:placeholder_password@placeholder_host:5432/placeholder_db?sslmode=require

# PostgreSQL URL alias recognized by Vercel Postgres / connection pooler. Do NOT wrap in quotes.
POSTGRES_URL=postgresql://postgres:placeholder_password@placeholder_host:5432/placeholder_db?sslmode=require

# PostgreSQL URL alias alternative. Do NOT wrap in quotes.
POSTGRESQL_URL=postgresql://postgres:placeholder_password@placeholder_host:5432/placeholder_db?sslmode=require

# Database connection pool max connections. Do NOT wrap in quotes.
DB_POOL_MAX=10

# Database connection idle timeout in milliseconds. Do NOT wrap in quotes.
DB_IDLE_TIMEOUT_MS=30000

# Database connection acquisition timeout in milliseconds. Do NOT wrap in quotes.
DB_CONNECTION_TIMEOUT_MS=10000

# Database query execution timeout in milliseconds. Do NOT wrap in quotes.
DB_QUERY_TIMEOUT_MS=15000

# Database statement timeout in milliseconds. Do NOT wrap in quotes.
DB_STATEMENT_TIMEOUT_MS=15000

# Google OAuth 2.0 Web Client ID exposed to frontend login buttons. Do NOT wrap in quotes.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=placeholder_client_id.apps.googleusercontent.com

# Google OAuth 2.0 Web Client ID for server-side token validation. Do NOT wrap in quotes.
GOOGLE_CLIENT_ID=placeholder_client_id.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret for server-side authorization code exchange. Do NOT wrap in quotes.
GOOGLE_CLIENT_SECRET=placeholder_google_oauth_client_secret

# LiveKit Cloud WebSocket URL for in-app voice calling (wss://...). Do NOT wrap in quotes.
LIVEKIT_URL=wss://placeholder-project.livekit.cloud

# LiveKit Cloud WebSocket URL public alias for frontend. Do NOT wrap in quotes.
NEXT_PUBLIC_LIVEKIT_URL=wss://placeholder-project.livekit.cloud

# LiveKit Cloud API Key. Do NOT wrap in quotes.
LIVEKIT_API_KEY=placeholder_livekit_api_key

# LiveKit Cloud API Secret. Do NOT wrap in quotes.
LIVEKIT_API_SECRET=placeholder_livekit_api_secret

# VAPID public key for Web Push notifications. Do NOT wrap in quotes.
VAPID_PUBLIC_KEY=placeholder_vapid_public_key

# VAPID public key exposed to browser service worker registration. Do NOT wrap in quotes.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=placeholder_vapid_public_key

# VAPID private key for signing Web Push notifications on server. Do NOT wrap in quotes.
VAPID_PRIVATE_KEY=placeholder_vapid_private_key

# VAPID subject email or URL for push service identification. Do NOT wrap in quotes.
VAPID_SUBJECT=mailto:support@belconnect.com

# Vercel Blob store token for candidate resume uploads. Do NOT wrap in quotes.
BLOB_READ_WRITE_TOKEN=placeholder_vercel_blob_token

# Google Maps API key for address geocoding and reverse geocoding on frontend. Do NOT wrap in quotes.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=placeholder_google_maps_api_key

# Google Maps API key fallback for server-side reverse geocoding. Do NOT wrap in quotes.
GOOGLE_MAPS_API_KEY=placeholder_google_maps_api_key

# HMAC secret key used for signing password reset OTP tokens. Do NOT wrap in quotes.
PASSWORD_RESET_OTP_SECRET=placeholder_otp_hmac_secret_must_be_long_and_random

# Password reset OTP expiration time in minutes. Do NOT wrap in quotes.
PASSWORD_RESET_OTP_TTL_MINUTES=10

# Password reset OTP resend cooldown in seconds. Do NOT wrap in quotes.
PASSWORD_RESET_RESEND_SECONDS=60

# SMTP mail relay host for transactional emails (e.g. Brevo). Do NOT wrap in quotes.
SMTP_HOST=smtp-relay.brevo.com

# SMTP mail relay port (typically 587 for TLS or 465 for SSL). Do NOT wrap in quotes.
SMTP_PORT=587

# Use SSL direct connection for SMTP (true for 465, false for 587). Do NOT wrap in quotes.
SMTP_SECURE=false

# SMTP login username or account email. Do NOT wrap in quotes.
SMTP_USER=placeholder_smtp_login

# SMTP login password or master API relay key. Do NOT wrap in quotes.
SMTP_PASS=placeholder_smtp_password

# Outgoing transactional sender email address. Do NOT wrap in quotes.
SMTP_FROM_EMAIL=no-reply@belconnect.com

# Outgoing transactional sender display name. Do NOT wrap in quotes.
SMTP_FROM_NAME=BelConnect

# Enable automated email notifications for job applications (true | false). Do NOT wrap in quotes.
JOB_EMAILS_ENABLED=false

# Enable transactional SMS sending (true | false). Do NOT wrap in quotes.
SMS_ENABLED=false

# SMS gateway provider name (e.g. fast2sms). Do NOT wrap in quotes.
SMS_PROVIDER=fast2sms

# SMS gateway API authentication key. Do NOT wrap in quotes.
SMS_API_KEY=placeholder_sms_api_key

# Registered DLT 6-character sender ID header for SMS. Do NOT wrap in quotes.
SMS_SENDER_ID=BELCON

# Approved TRAI DLT template ID for transactional SMS in India. Do NOT wrap in quotes.
SMS_DLT_TEMPLATE_ID=placeholder_dlt_template_id

# Upstash Redis REST URL for distributed rate limiting across serverless instances (optional). Do NOT wrap in quotes.
UPSTASH_REDIS_REST_URL=https://placeholder.upstash.io

# Upstash Redis REST token for distributed rate limiting (optional). Do NOT wrap in quotes.
UPSTASH_REDIS_REST_TOKEN=placeholder_upstash_token

# Demo UI mode toggle (must be false in production). Do NOT wrap in quotes.
NEXT_PUBLIC_DEMO_MODE=false

# Optional client-side API URL override. Do NOT wrap in quotes.
NEXT_PUBLIC_API_URL=https://belconnect.vercel.app

# Shared secret for authenticating the /api/cron/expire-bookings auto-expiry sweep endpoint. Do NOT wrap in quotes.
CRON_SECRET=placeholder_cron_secret_must_be_at_least_32_characters_long

# Maps Provider configuration (google | osm). In production, defaults strictly to google. Do NOT wrap in quotes.
MAPS_PROVIDER=google

# Google Maps Platform Server-Side API Key (Directions, Geocoding). Never exposed to client. Do NOT wrap in quotes.
GOOGLE_MAPS_API_KEY=placeholder_google_maps_server_api_key

# Google Maps Platform Client-Side API Key (Restricted by HTTP Referrers and Android Package/SHA-1). Do NOT wrap in quotes.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=placeholder_google_maps_client_api_key

# Allow fallback to public OSM services in non-production environments (false in production). Do NOT wrap in quotes.
ALLOW_PUBLIC_OSM=false

# ==============================================================================
# SEO & CANONICAL DOMAIN CONFIGURATION
# ==============================================================================
# Public production site canonical URL (no trailing slash). Required in production. Do NOT wrap in quotes.
NEXT_PUBLIC_SITE_URL=https://belconnect.in

# Public support and grievance officer emails for schema and legal footer. Do NOT wrap in quotes.
NEXT_PUBLIC_SUPPORT_EMAIL=support@belconnect.in
NEXT_PUBLIC_GRIEVANCE_EMAIL=grievance@belconnect.in

# Search Console Verification Codes (HTML meta tag verification). Do NOT wrap in quotes.
GOOGLE_SITE_VERIFICATION=placeholder_google_site_verification_token
BING_SITE_VERIFICATION=placeholder_bing_site_verification_token

# Social Profile Links for Organization Structured Data (sameAs). Do NOT wrap in quotes.
NEXT_PUBLIC_SOCIAL_TWITTER=https://twitter.com/BelConnect
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/BelConnect
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/BelConnect
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/belconnect

