# ==============================================================================
# BELCONNECT FRONTEND (VERCEL DEPLOYMENT) ENVIRONMENT VARIABLE TEMPLATE
# ==============================================================================
# Configure these in Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================================

# Core Environment Mode
NODE_ENV=production
NEXT_PUBLIC_DEMO_MODE=false

# Public App URL (Your Vercel Deployment Domain)
NEXT_PUBLIC_APP_URL=https://your-app-name.vercel.app
APP_URL=https://your-app-name.vercel.app

# Real-Time Socket.IO Signaling Server URL (Your Render Backend Domain)
NEXT_PUBLIC_SIGNALING_URL=https://your-signaling-service.onrender.com
SIGNALING_SERVER_URL=https://your-signaling-service.onrender.com

# Database Connection URL (PostgreSQL)
DATABASE_URL=postgresql://user:password@your-cloud-db-host.neon.tech/cityconnect?sslmode=require

# Authentication Secrets
JWT_SECRET=your_production_jwt_secret_64_chars_long
SIGNALING_INTERNAL_SECRET=your_production_signaling_internal_secret

# Google OAuth Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# LiveKit Voice Calling Credentials
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Web Push Notification Credentials (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:support@belconnect.com

# SMTP & Password Reset Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM_EMAIL=no-reply@belconnect.com
SMTP_FROM_NAME=BelConnect

PASSWORD_RESET_OTP_SECRET=your_secure_hmac_secret
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_RESEND_SECONDS=60
