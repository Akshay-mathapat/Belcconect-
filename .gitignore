# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node dependencies
node_modules/
**/node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.*

# Next.js build output
.next/
frontend/.next/
out/
frontend/out/

# Production build artifacts
build/
frontend/build/

# Environment files (NEVER COMMIT SECRETS)
.env
.env.*
.env*.local
frontend/.env
frontend/.env.*
frontend/.env*.local
backend/.env
backend/.env.*
backend/.env*.local
**/.env
**/.env.*
**/.env*.local
!.env.example
!frontend/.env.example
!backend/.env.example

# Vercel
.vercel

# Misc & OS files
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

*.apk


# Load test credentials
loadtest/tokens*.json

# Playwright test artifacts
playwright-report/
**/playwright-report/
test-results/
**/test-results/

# Android & Gradle caches (must never be committed)
.gradle/
**/.gradle/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/*.iml
android/app/*.iml
android/**/build/
*.hprof

