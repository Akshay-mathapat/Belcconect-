# ==============================================================================
# BELCONNECT BACKEND (RENDER DEPLOYMENT) ENVIRONMENT VARIABLE TEMPLATE
# ==============================================================================
# Configure these variables in Render Dashboard -> Web Service -> Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV=production

# Server Port (Render automatically sets PORT dynamically)
PORT=4001

# Production PostgreSQL Database URL (Neon / Supabase / Render Postgres)
DATABASE_URL=postgresql://user:password@your-cloud-db-host.neon.tech/cityconnect?sslmode=require

# Authentication Secrets (Must match Frontend Vercel JWT_SECRET)
JWT_SECRET=your_production_jwt_secret_64_chars_long
SIGNALING_INTERNAL_SECRET=your_production_signaling_internal_secret

# CORS Allowed Frontend Origin (Your Vercel Deployment Domain)
ALLOWED_ORIGIN=https://your-app-name.vercel.app

# Public Frontend Application URL (For Web Push triggering)
APP_URL=https://your-app-name.vercel.app
