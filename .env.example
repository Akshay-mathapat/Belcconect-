# Environment Configuration Template for CityConnect / BelConnect

# Environment Mode
NODE_ENV=production
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Cloud Deployment Port Configuration
PORT=4001
SIGNALING_PORT=4001
ALLOWED_ORIGIN=https://your-domain.com

# Database Connection URL (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/cityconnect

# Authentication Secrets
JWT_SECRET=your_secure_jwt_secret_key_here
SIGNALING_INTERNAL_SECRET=your_signaling_internal_secret_key_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
APP_URL=https://your-domain.com
# Public HTTPS origin used by the packaged Capacitor app for OAuth.
NEXT_PUBLIC_APP_URL=https://your-domain.com
# Optional: remote URL loaded by the packaged Capacitor WebView.
CAPACITOR_SERVER_URL=https://your-domain.com

# Real-Time Socket.IO Signaling Server
# DO NOT USE localhost IN PRODUCTION
NEXT_PUBLIC_SIGNALING_URL=https://signal.yourdomain.com
SIGNALING_SERVER_URL=https://signal.yourdomain.com

# LiveKit Voice Calling Credentials (NEVER expose LIVEKIT_API_SECRET)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Web Push Notification Credentials (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_SUBJECT=mailto:support@belconnect.com

# Transactional SMS Notification Configuration
SMS_ENABLED=false
SMS_PROVIDER=fast2sms
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=BELCON
SMS_DLT_TEMPLATE_ID=your_dlt_template_id

# Brevo SMTP Configuration for Password Reset & Email Notifications
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key

SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME=BelConnect

PASSWORD_RESET_OTP_SECRET=your_secure_hmac_secret_for_otp_hashing
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_RESEND_SECONDS=60

