# ==============================================================================
# CITYCONNECT / BELCONNECT PRODUCTION & LOCAL ENVIRONMENT VARIABLE TEMPLATE
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - NEVER COMMIT REAL SECRETS OR PRODUCTION PASSWORDS TO GIT OR PUBLIC REPOS.
# - COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT.
# - SET THESE VARIABLES IN THE RESPECTIVE CLOUD DASHBOARDS (VERCEL / RENDER).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE ENVIRONMENT & DEPLOYMENT PORT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4001
SIGNALING_PORT=4001

# ------------------------------------------------------------------------------
# 2. PRODUCTION POSTGRESQL DATABASE (NEON / SUPABASE / RENDER POSTGRES)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[cloud-host]:5432/[database_name]?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@your-cloud-db-host.neon.tech/cityconnect?sslmode=require

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & INTERNAL COMMUNICATION SECRETS
# ------------------------------------------------------------------------------
# Generate strong 64-character random strings for production secrets
JWT_SECRET=your_production_jwt_secret_64_chars_long
SIGNALING_INTERNAL_SECRET=your_production_signaling_internal_secret
PASSWORD_RESET_OTP_SECRET=your_production_otp_hmac_secret
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_RESEND_SECONDS=60

# ------------------------------------------------------------------------------
# 4. FRONTEND DEPLOYMENT (VERCEL ENVIRONMENT VARIABLES)
# Configure these in Vercel Project Settings -> Environment Variables
# ------------------------------------------------------------------------------
# Public App URL (Your Vercel Deployment Domain)
NEXT_PUBLIC_APP_URL=https://belconnect.vercel.app
APP_URL=https://belconnect.vercel.app

# Real-Time Socket.IO Signaling Server URL (Your Render Backend Web Service Domain)
# Example: https://belconnect-signaling.onrender.com
NEXT_PUBLIC_SIGNALING_URL=https://your-signaling-service.onrender.com
SIGNALING_SERVER_URL=https://your-signaling-service.onrender.com

# Google OAuth Client ID for Frontend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# LiveKit Voice Calling Configuration
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Web Push Notification Credentials (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:support@belconnect.com

# ------------------------------------------------------------------------------
# 5. BACKEND DEPLOYMENT (RENDER SIGNALING SERVICE ENVIRONMENT VARIABLES)
# Configure these in Render Web Service -> Environment Variables
# ------------------------------------------------------------------------------
# Render auto-assigns PORT, but you can set ALLOWED_ORIGIN to your Vercel URL:
ALLOWED_ORIGIN=https://belconnect.vercel.app
# Required on Render: DATABASE_URL, JWT_SECRET, SIGNALING_INTERNAL_SECRET, APP_URL

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL SMS & EMAIL NOTIFICATIONS (BREVO SMTP / FAST2SMS)
# ------------------------------------------------------------------------------
SMS_ENABLED=false
SMS_PROVIDER=fast2sms
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=BELCON
SMS_DLT_TEMPLATE_ID=your_dlt_template_id

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM_EMAIL=no-reply@belconnect.com
SMTP_FROM_NAME=BelConnect
