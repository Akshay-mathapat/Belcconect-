# Environment Configuration Template for CityConnect / BelConnect

# Environment Mode
NODE_ENV=production
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Cloud Deployment Port Configuration
PORT=4001
SIGNALING_PORT=4001
ALLOWED_ORIGIN=https://your-domain.com

# Database Connection URL (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/cityconnect

# Authentication Secrets
JWT_SECRET=your_secure_jwt_secret_key_here
SIGNALING_INTERNAL_SECRET=your_signaling_internal_secret_key_here

# Real-Time Socket.IO Signaling Server
SIGNALING_SERVER_URL=http://localhost:4001
NEXT_PUBLIC_SIGNALING_URL=http://localhost:4001

# LiveKit Voice Calling Credentials
LIVEKIT_URL=wss://your-livekit-domain.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Web Push Notification Credentials (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_SUBJECT=mailto:support@belconnect.com

# Transactional SMS Notification Configuration
SMS_ENABLED=false
SMS_PROVIDER=fast2sms
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=BELCON
SMS_DLT_TEMPLATE_ID=your_dlt_template_id
